{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fjaeckel/open-aircrew-rules/schema/messages.schema.json",
  "title": "Message keys",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys"],
  "properties": {
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "kind", "params"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$" },
          "kind": { "enum": ["message", "requirement_name", "requirement_message", "remedy", "rule_description", "training_title", "training_item", "training_message"] },
          "params": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+\\??$" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
