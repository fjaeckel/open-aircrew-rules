{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fjaeckel/open-aircrew-rules/schema/policies.schema.json",
  "title": "Policies: conventions with no legal text behind them (policies.yaml, fragments/policies/*.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["policies"],
  "properties": {
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
