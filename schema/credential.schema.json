{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fjaeckel/open-aircrew-rules/schema/credential.schema.json",
  "title": "Credential file (credentials/<authority>/<kind dir>/<name>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["credential", "id", "kind", "authority", "selects", "evaluations"],
  "properties": {
    "credential": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+\\.[a-z0-9-]+$" },
    "kind": { "enum": ["licence", "rating", "privilege", "endorsement", "instructor_certificate", "examiner_certificate", "medical"] },
    "authority": { "type": "string", "minLength": 1 },
    "held_on": { "type": "array", "items": { "type": "string" } },
    "selects": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "licence": { "$ref": "#/$defs/part" },
        "ratings": { "$ref": "#/$defs/part" },
        "privilege": { "$ref": "#/$defs/part" },
        "credential": { "$ref": "#/$defs/part" }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": { "period_months": { "type": "integer" }, "ref": { "type": "string" }, "note": { "type": "string" } }
    },
    "evaluations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evaluation" } },
    "interpretations": { "type": "array", "items": { "$ref": "#/$defs/interpretation" } }
  },
  "$defs": {
    "names": { "type": "array", "items": { "type": "string" } },
    "credentialIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+\\.[a-z0-9-]+$" } },
    "ref": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kinds": { "$ref": "#/$defs/names" },
        "classes": { "$ref": "#/$defs/names" },
        "authorities": { "$ref": "#/$defs/names" },
        "not_authorities": { "$ref": "#/$defs/names" },
        "licence_kinds": { "$ref": "#/$defs/names" },
        "not_licence_kinds": { "$ref": "#/$defs/names" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorities": { "$ref": "#/$defs/names" },
        "not_authorities": { "$ref": "#/$defs/names" },
        "licence_kinds": { "$ref": "#/$defs/names" },
        "not_licence_kinds": { "$ref": "#/$defs/names" },
        "classes": { "$ref": "#/$defs/names" },
        "not_classes": { "$ref": "#/$defs/names" },
        "credential_types": { "$ref": "#/$defs/names" },
        "privilege_kinds": { "$ref": "#/$defs/names" },
        "launch_methods": { "$ref": "#/$defs/names" },
        "type_rated": { "type": ["boolean", "string"] },
        "programme": { "type": "string" },
        "when_holding": { "type": "object" },
        "ref": { "$ref": "#/$defs/ref" }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "asks": { "type": "string" },
        "source": { "type": "string" },
        "also_cites": { "$ref": "#/$defs/names" },
        "uses": { "type": "string" },
        "with": { "type": "object" },
        "requires_all": { "$ref": "#/$defs/credentialIds" },
        "requires_any": { "$ref": "#/$defs/credentialIds" },
        "about": { "type": "string" },
        "only_for": { "$ref": "#/$defs/scope" },
        "scope": { "$ref": "#/$defs/scope" },
        "relevant_class": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pooled_with_held", "ref"],
          "properties": { "pooled_with_held": { "$ref": "#/$defs/names" }, "ref": { "$ref": "#/$defs/ref" } }
        },
        "counting": { "type": "object" },
        "passes_if": { "type": "object" },
        "restored_by": { "type": "array", "items": { "type": "object" } },
        "valid_for": {
          "type": "object",
          "additionalProperties": false,
          "required": ["periods"],
          "properties": {
            "counted_from": { "enum": ["issue", "valid_from"] },
            "ref": { "$ref": "#/$defs/ref" },
            "periods": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["months", "ref"],
                "properties": {
                  "age_under": { "type": "integer" },
                  "age_from": { "type": "integer" },
                  "months": { "type": "integer", "minimum": 1 },
                  "ends_at_age": { "type": "integer" },
                  "end_of_month": { "type": "boolean" },
                  "ref": { "$ref": "#/$defs/ref" }
                }
              }
            }
          }
        },
        "outcomes": { "type": ["string", "array", "object"] },
        "description_key": { "type": "string" },
        "effective_from": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "effective_to": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "on_fail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["what", "ref"],
          "properties": { "what": { "type": "string" }, "ref": { "$ref": "#/$defs/ref" } }
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reading", "ref", "affects", "approved_by", "approved_on"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "reading": { "type": "string", "minLength": 1 },
        "ref": { "$ref": "#/$defs/ref" },
        "affects": { "$ref": "#/$defs/names" },
        "approved_by": { "type": ["string", "null"] },
        "approved_on": { "type": ["string", "null"] }
      }
    }
  }
}
