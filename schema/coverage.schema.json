{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fjaeckel/open-aircrew-rules/schema/coverage.schema.json",
  "title": "Articles in scope and the evaluations that encode them (coverage/articles.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["articles"],
  "properties": {
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["article"],
        "minProperties": 2,
        "properties": {
          "article": { "type": "string" },
          "evaluations": { "type": "array", "items": { "type": "string" } },
          "pending": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]+/(licences|ratings|privileges|endorsements|instructors|examiners|medicals)/[a-z0-9-]+$" } },
          "note": { "type": "string", "minLength": 1 },
          "not_evaluated": { "type": "string", "minLength": 1 }
        },
        "dependentRequired": { "pending": ["note"], "note": ["pending"] }
      }
    }
  }
}
